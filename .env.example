# Create real .env using Setup-PROD.ps1. No UAT settings or credentials belong here.
MYSQL_ROOT_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
MYSQL_PASSWORD=REPLACE_WITH_ANOTHER_RANDOM_ALPHANUMERIC_PASSWORD
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_PASSWORD
COOKIE_SECURE=true
SSL_BIND_IP=REPLACE_WITH_PROD_IPV4
PORTAL_URL=https://REPLACE_WITH_PROD_IPV4
# Keep local staging attached to Docker. External drives are used only by Move-ArchiveOffline.ps1.
ARCHIVE_HOST_PATH=./MOMCC_Archive
ARCHIVE_ENABLED=true
ARCHIVE_PURGE_ENABLED=false
# Enable only after validating PROD. Do not copy the UAT group ID blindly.
WAHA_ENABLED=false
WAHA_URL=
WAHA_API_KEY=
WAHA_SESSION=default
WAHA_GROUP_CHAT_ID=
